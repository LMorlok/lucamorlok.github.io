{% if site.visitor_globe.enabled %}
  <a href="https://mapmyvisitors.com/" title="Visitor Map" style="display:inline-block;vertical-align:middle;margin-right:6px;">
    <iframe
      src="{{ '/assets/html/visitor-globe.html' | relative_url }}"
      style="width:40px;height:40px;border:none;overflow:hidden;background:transparent;"
      scrolling="no"
      frameborder="0"
      allowtransparency="true"
    ></iframe>
  </a>
{% endif %}
